--- before/tests/test_create.py
+++ after/tests/test_create.py
@@ -1,0 +2 @@
+from copy import deepcopy
@@ -10,0 +12,24 @@
+
+    def test_normalized_title_is_stored_and_returned(self):
+        store = {}
+        result = create_task(store, 'a', ' \tMinha  tarefa\n ')
+        self.assertEqual(result, {'title': 'Minha  tarefa'})
+        self.assertEqual(store, {'a': {'title': 'Minha  tarefa'}})
+        result['title'] = 'Changed copy'
+        self.assertEqual(store['a']['title'], 'Minha  tarefa')
+
+    def test_invalid_titles_preserve_entire_store(self):
+        for title in ('', '   ', '\t\n', None, 0, [], {}):
+            with self.subTest(title=title):
+                store = {'a': {'title': 'Before', 'extra': ['keep']}}
+                before = deepcopy(store)
+                with self.assertRaisesRegex(ValueError, '^title required$'):
+                    create_task(store, 'b', title)
+                self.assertEqual(store, before)
+
+    def test_duplicate_preserves_entire_store(self):
+        store = {'a': {'title': 'Before'}}
+        before = deepcopy(store)
+        with self.assertRaisesRegex(ValueError, '^duplicate task$'):
+            create_task(store, 'a', '  Replacement  ')
+        self.assertEqual(store, before)
--- before/tests/test_rename.py
+++ after/tests/test_rename.py
@@ -1,0 +2 @@
+from copy import deepcopy
@@ -10,0 +12,26 @@
+
+    def test_normalized_title_is_stored_and_returned(self):
+        store = {'a': {'title': 'Before'}}
+        result = rename_task(store, 'a', ' \tMinha  tarefa\n ')
+        self.assertEqual(result, {'title': 'Minha  tarefa'})
+        self.assertEqual(store, {'a': {'title': 'Minha  tarefa'}})
+        result['title'] = 'Changed copy'
+        self.assertEqual(store['a']['title'], 'Minha  tarefa')
+
+    def test_invalid_titles_preserve_entire_store(self):
+        for title in ('', '   ', '\t\n', None, 0, [], {}):
+            with self.subTest(title=title):
+                store = {'a': {'title': 'Before', 'extra': ['keep']},
+                         'b': {'title': 'Other'}}
+                before = deepcopy(store)
+                with self.assertRaisesRegex(ValueError, '^title required$'):
+                    rename_task(store, 'a', title)
+                self.assertEqual(store, before)
+
+    def test_missing_id_preserves_entire_store(self):
+        store = {'a': {'title': 'Before'}}
+        before = deepcopy(store)
+        with self.assertRaises(KeyError) as error:
+            rename_task(store, 'b', '  Replacement  ')
+        self.assertEqual(error.exception.args, ('b',))
+        self.assertEqual(store, before)
